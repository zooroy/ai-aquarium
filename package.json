{
  "name": "ai-aquarium",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "predev": "node scripts/copy-mediapipe-wasm.mjs",
    "prebuild": "node scripts/copy-mediapipe-wasm.mjs",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "simplex-noise": "^4.0.3",
    "three": "^0.180.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/three": "^0.180.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11",
    "wrangler": "4.151.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true
  }
}
